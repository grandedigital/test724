{
  "kind": "collectionType",
  "collectionName": "vehicles",
  "info": {
    "singularName": "vehicle",
    "pluralName": "vehicles",
    "displayName": "Vehicle",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "shortDescription": {
      "type": "text"
    },
    "longDescription": {
      "type": "blocks"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.seo"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "string",
      "required": true
    },
    "capacity": {
      "type": "string",
      "required": true
    },
    "largeSuitcases": {
      "type": "string",
      "required": true
    },
    "smallCarryOn": {
      "type": "string",
      "required": true
    },
    "interior": {
      "type": "string",
      "required": true
    },
    "dailyPrice": {
      "type": "decimal",
      "required": true
    },
    "hourlyPrice": {
      "type": "decimal",
      "required": true
    },
    "line": {
      "type": "integer",
      "required": true
    },
    "prices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::price.price",
      "mappedBy": "vehicle"
    },
    "reservation": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::reservation.reservation",
      "mappedBy": "vehicle"
    },
    "feature": {
      "type": "component",
      "repeatable": true,
      "component": "features.features"
    },
    "featureSectionTitle": {
      "type": "string"
    }
  }
}
